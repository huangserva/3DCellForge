# Tripo —— v3 为默认（官方现版本）。设为 v2 回退到已验证的旧实现。
# v3 依据官方文档编写，尚未用真实 key 实测；如遇问题改成 v2 并反馈。
TRIPO_API_KEY=your_tripo_api_key
TRIPO_API_VERSION=v3
TRIPO_MODEL_VERSION=v3.0-20250812
# 仅 TRIPO_API_VERSION=v2 时使用
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi

RODIN_API_KEY=your_rodin_api_key
RODIN_API_BASE=https://api.hyper3d.com/api/v2
RODIN_TIER=Gen-2
RODIN_QUALITY=medium
RODIN_MESH_MODE=Raw
RODIN_MATERIAL=PBR

FAL_API_KEY=your_fal_api_key
FAL_DEFAULT_MODEL=fal-ai/hitem3d/hi3d/v3.0/image-to-3d

VISION_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4o-mini

HUNYUAN_API_BASE=http://127.0.0.1:8081
HUNYUAN_CREATE_PATH=/send
HUNYUAN_STATUS_PATH=/status

# 能力路由开关。on = 走新的能力注册表；off = 走原有 if-else 分发（安全阀）
CAPABILITY_ROUTER=on

API_PORT=8787
API_HOST=127.0.0.1
LOCAL_MODEL_DIR=.generated-models
LOG_DIR=.logs
LOG_FILE=forge3d-api.log
